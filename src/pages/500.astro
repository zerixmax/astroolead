---
// src/pages/500.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { Image } from 'astro:assets';
import bgImage from '../assets/images/olea-digitalis-postine_1924.webp';

interface Props {
  error: unknown;
}

const { error } = Astro.props;
---

<Layout
  title="500 - Pogreška na poslužitelju | OleaD"
  description="Došlo je do pogreške na poslužitelju. Molimo pokušajte ponovno kasnije."
  lang="hr"
>
  <Navbar lang="hr" />

  <main
    class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 text-center"
  >
    <!-- Static Image Background -->
    <div class="absolute inset-0 z-0 h-full w-full">
      <Image
        src={bgImage}
        alt="Olea Digitalis Olive Grove"
        class="h-full w-full object-cover"
        loading="eager"
      />
    </div>

    <!-- Tamni overlay sloj bez blura -->
    <div class="absolute inset-0 z-10 bg-black/60"></div>

    <!-- Sadržaj 500 sekcije (bijeli tekst bez pozadine) -->
    <div class="relative z-20 flex max-w-2xl flex-col items-center p-8">
      <span
        class="text-red-500 animate-pulse font-mono text-8xl drop-shadow-md md:text-9xl font-bold"
        >500</span
      >
      <h1
        class="mt-6 mb-4 font-serif text-3xl font-bold text-white italic drop-shadow-md md:text-5xl"
      >
        Došlo je do pogreške
      </h1>
      <p class="text-olea-sand mb-10 max-w-md text-lg leading-relaxed">
        Ispričavamo se, došlo je do neočekivane pogreške na poslužitelju.
        Molimo pokušajte ponovno kasnije.
      </p>
      {error && (
        <pre class="bg-black/50 text-red-300 font-mono text-xs p-4 rounded-lg mb-8 max-w-full overflow-auto text-left border border-red-500/20">
          {error instanceof Error ? error.message : String(error)}
        </pre>
      )}
      <a
        href="/hr/"
        class="bg-olea-olive hover:text-olea-olive rounded-full px-8 py-3.5 font-sans text-lg font-semibold tracking-wider text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-white hover:shadow-xl active:scale-95"
      >
        Vrati se na početnu stranicu
      </a>
    </div>
  </main>

  <Footer lang="hr" />
</Layout>
