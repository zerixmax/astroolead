---
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  lang?: string;
  hrUrlProp?: string;
  enUrlProp?: string;
  canonicalPath?: string;
}

const {
  title,
  description = 'Digitalna sljedivost maslinovog ulja.',
  keywords = 'maslinovo ulje, sljedivost, OPG',
  lang = 'hr',
  hrUrlProp,
  enUrlProp,
  canonicalPath,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      lang={lang}
      hrUrl={hrUrlProp}
      enUrl={enUrlProp}
      canonicalPath={canonicalPath}
    />
    <Schema type="Organization" lang={lang} />
    <Schema type="LocalBusiness" lang={lang} />
    <Schema type="Product" lang={lang} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body
    class="bg-olea-sand text-olea-earth flex min-h-dvh flex-col overflow-x-hidden font-sans antialiased"
  >
    <slot />

    <!-- Back to Top Button -->
    <button
      id="back-to-top"
      class="border-olea-olive/20 text-olea-olive hover:bg-olea-olive pointer-events-none fixed right-6 bottom-28 z-50 flex h-12 w-12 translate-y-16 cursor-pointer items-center justify-center rounded-full border bg-white/80 opacity-0 shadow-lg backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-white active:scale-95"
      aria-label="Back to top"
    >
      <span class="animate-float">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"
          ></path>
        </svg>
      </span>
    </button>

    <script>
      function initScrollReveal() {
        // Native check: if browser supports CSS scroll-driven animations, exit and let CSS handle it.
        if (
          CSS.supports(
            '(animation-timeline: view()) and (animation-range: entry)'
          )
        ) {
          return;
        }

        // JS Fallback for other browsers (like Firefox or older versions)
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                // Unobserve to run the animation only once
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1, // Trigger when 10% of the element is visible
            rootMargin: '0px 0px -40px 0px', // Slight offset for more natural feel
          }
        );

        document.querySelectorAll('.scroll-reveal').forEach((el) => {
          observer.observe(el);
        });
      }

      // Keep track of scroll listener to prevent duplicate binding
      let scrollListenerActive = false;

      function initBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        const toggleVisibility = () => {
          if (window.scrollY > 300) {
            btn.classList.add('show-btn');
          } else {
            btn.classList.remove('show-btn');
          }
        };

        // Scroll to top on click
        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth',
          });
        });

        // Run initial check
        toggleVisibility();

        if (!scrollListenerActive) {
          window.addEventListener('scroll', () => {
            const activeBtn = document.getElementById('back-to-top');
            if (activeBtn) {
              if (window.scrollY > 300) {
                activeBtn.classList.add('show-btn');
              } else {
                activeBtn.classList.remove('show-btn');
              }
            }
          });
          scrollListenerActive = true;
        }
      }

      // Run on page load and on Astro View Transitions navigation
      document.addEventListener('astro:page-load', () => {
        initScrollReveal();
        initBackToTop();
      });
    </script>
  </body>
</html>
